<Window x:Class="WinClicker.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Clicker Overlay"
        Width="340"
        Height="72"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        Opacity="0"
        MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
        LocationChanged="Overlay_LocationChanged">
    <Border x:Name="OverlayFrame"
            Background="#EE111419"
            BorderBrush="#3A424F"
            BorderThickness="1"
            CornerRadius="15"
            Padding="15,11"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.46" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid x:Name="CompactPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentMutedBrush}" Margin="0,0,12,0">
                    <Grid>
                        <Ellipse x:Name="CompactPulse" Width="12" Height="12" Fill="{DynamicResource TextMutedBrush}" />
                        <Ellipse Width="5" Height="5" Fill="White" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="AUTO CLICKER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="CompactStateText" Text="OFF" FontSize="17" FontWeight="SemiBold" Margin="0,1,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="CompactCpsText" Text="0 CPS" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                    <TextBlock x:Name="CompactIntervalText" Text="L 50 ms  •  R 50 ms" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ExtendedPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AccentMutedBrush}" Margin="0,0,14,0">
                    <Grid>
                        <Path Data="{StaticResource IconMouse}" Fill="{DynamicResource AccentBrush}" Width="24" Height="24" Stretch="Uniform" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ExtendedDot" Width="7" Height="7" Fill="{DynamicResource TextMutedBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="AUTO CLICKER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="ExtendedStateText" Text="OFF" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="ExtendedLeftText" Text="LMB  0 CPS  •  50 ms" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock x:Name="ExtendedRightText" Text="RMB  0 CPS  •  50 ms" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>

            <Border x:Name="EditBadge"
                    Visibility="Collapsed"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="8"
                    Padding="8,4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,2">
                <TextBlock Text="ПЕРЕТАЩИТЕ • ESC ДЛЯ ГОТОВО" FontSize="9" FontWeight="Bold" Foreground="White" />
            </Border>
        </Grid>
    </Border>
</Window>
