<Window x:Class="WinClicker.UI.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        SizeToContent="Height"
        MinHeight="290"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Background="#FB111419"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="38" ShadowDepth="14" Opacity="0.58" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource AccentMutedBrush}" Margin="0,0,14,0">
                    <Path x:Name="DialogIcon" Data="{StaticResource IconShield}" Fill="{DynamicResource AccentBrush}" Width="24" Height="24" Stretch="Uniform" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="DialogEyebrow" Text="AUTO CLICKER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="DialogTitle" Text="Подтверждение" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="DialogMessage"
                       Grid.Row="1"
                       FontSize="13"
                       LineHeight="21"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,22,0,26" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NoButton" Content="ОТМЕНА" Style="{StaticResource SecondaryButtonStyle}" MinWidth="130" Margin="0,0,10,0" Click="No_Click" />
                <Button x:Name="YesButton" Content="ПРОДОЛЖИТЬ" Style="{StaticResource PrimaryButtonStyle}" MinWidth="150" Click="Yes_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
