<Window x:Class="WinClicker.UI.HotkeyCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Назначить хоткей"
        Width="500"
        Height="320"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Dialog_SourceInitialized">
    <Border Background="#FB111419"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="12" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="НОВЫЙ ХОТКЕЙ" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="Нажмите клавишу или кнопку мыши" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="Поддерживаются Mouse 3 / Mouse 4 / Mouse 5 и комбинации с Ctrl, Alt, Shift или Win."
                           Style="{StaticResource MutedTextStyle}"
                           Margin="0,8,0,0" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Margin="0,22,0,18"
                    Padding="20">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="42" Height="42">
                        <Ellipse Fill="{DynamicResource AccentMutedBrush}" />
                        <Path Data="{StaticResource IconKeyboard}" Fill="{DynamicResource AccentBrush}" Width="23" Height="23" Stretch="Uniform" />
                    </Grid>
                    <TextBlock x:Name="CurrentBindingText" Text="Ожидание ввода…" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="Esc — отменить" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Button Grid.Row="2" Content="ОТМЕНА" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Width="130" Click="Cancel_Click" />
        </Grid>
    </Border>
</Window>
